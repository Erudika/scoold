											<div class="col s12 m2">
												<button type="submit" class="btn-small btn-flat waves-effect waves-light rusure">&nbsp;$!lang.get('save')</button>
											</div>
										</div>
									</form>
								</td>
							</tr>
						#end
						</table>
					</div>
				</li>
