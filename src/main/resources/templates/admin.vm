										<input type="checkbox" name="isso" class="filled-in">
										<span>$!lang.get('admin.soarchive')</span>
									</label>
									<label class="mll">
										<input type="checkbox" name="deleteall" class="filled-in">
										<span>$!lang.get('admin.cleanimport')</span>
