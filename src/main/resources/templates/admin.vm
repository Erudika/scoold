					<tbody>
					#foreach($question in $dashboard.get('oldestUnanswered'))
						<tr>
							<td><a href="$questionlink/$!question.get('id')">$!question.get('title')</a></td>
							<td class="right-align">$!question.get('date')</td>
						</tr>
					#end
					</tbody>
				</table>
			</div>

			#macro(activitypage $param )
				<table class="highlight responsive-table dashboard-table">
					<thead>
						<tr>
							<th>User ID</th>
							<th>Req Method</th>
							<th>Req IP</th>
							<th>$!lang.get('date')</th>
							<th>Request URI</th>
						</tr>
					</thead>
					<tbody>
						#foreach($activity in $activities)
							<tr>
								<td>
								#if($activity.getCreatorid() == 'anonymous')
									<code class="dashboard-code">$!activity.getCreatorid()</code>
								#else
									<a href="$profilelink/$!activity.getCreatorid().replaceAll(':profile$', '')">
										<code class="dashboard-code">$!activity.getCreatorid().substring(0, $!activity.getCreatorid().indexOf(":"))</code>
									</a>
								#end
								</td>
								<td><code class="dashboard-code">$!activity.properties.method</code></td>
								<td><code class="dashboard-code">$!activity.properties.ip</code></td>
								<td>#formatdate($!activity.timestamp, "YYYY-MM-dd HH:mm:ss")</td>
								<td><code class="dashboard-code">$!activity.properties.path</code></td>
							</tr>
						#end
					</tbody>
				</table>
			#end

			<div class="dashboard-panel">
				<div class="dashboard-panel-heading">
					<h4 class="dashboard-panel-title">$!lang.get('admin.dashboard.auditLog')</h4>
					<a href="$adminlink/clear-activity-log" class="post-refresh-ask">$!lang.get('clear')</a>
				</div>
				#if($trackingEnabled)
					#paginate("activity" $itemcount "" "page")
				#else
					<p class="grey-text dashboard-empty">$!lang.get('admin.dashboard.trackingDisabled')</p>
				#end
			</div>
		</div>

		#end
	</div>
#end
