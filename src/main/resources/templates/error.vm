<div class="page-wrapper">
	<div class="container center pal">
		<div class="mbl em5v">
			<a href="/">
				<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" aria-labelledby="title desc" viewBox="0 0 460 460">
					<g fill="none" stroke-linecap="round" stroke-linejoin="round" style="transform-origin:29.1502px 29.1502px" transform="translate(-28.65 -28.65)scale(1.01168)">
						<rect width="428" height="428" x="42" y="42" stroke="#c5ced6" stroke-width="24" rx="42"/>
						<path stroke="#279bc9" stroke-width="24" d="M219 235h74"/>
						<circle cx="145" cy="235" r="73" stroke="#279bc9" stroke-width="24"/>
						<path stroke="#279bc9" stroke-width="24" d="M145 194v82"/>
						<circle cx="367" cy="235" r="73" stroke="#279bc9" stroke-width="24"/>
						<circle cx="367" cy="235" r="34" stroke="#279bc9" stroke-width="20"/>
						<path stroke="#c5ced6" d="M184.852 390h142.296" style="stroke-width:24px"/>
					</g>
				</svg>
			</a>
		</div>
		#if ($code == "403")
		<h1>$!lang.get("forbidden")</h1>
		#elseif ($code == "400")
		<h1>$!lang.get("badrequest")</h1>
		#elseif ($code == "401")
		<h1>$!lang.get("msgcode.3")</h1>
		#elseif ($code == "500")
		<h1>$!lang.get("servererror")</h1>
		#elseif ($code == "503")
		<h1>$!lang.get("sitedown")</h1>
		#else
		<h2>$!lang.get("error.title")</h2>
		#end

		#if($code == "500" && $scooldUtils.looksLikeNotConnectedToPara($reason))
			<h4 class="red-text">No connection to Para backend.</h4>
		#else
			$!status $!reason
		#end
		<br>
	</div>
</div>
